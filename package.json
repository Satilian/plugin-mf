{
  "name": "plugin-mf",
  "version": "0.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./shared": {
      "types": "./dist/shared.d.ts",
      "import": "./dist/shared.js"
    }
  },
  "types": "./dist/index.d.ts",
  "bin": {
    "plugin-mf-types": "./dist/build/types-cli.js"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@rsbuild/core": "^2.2.1",
    "@types/react": "^19.2.18",
    "react": "^19.2.8"
  },
  "dependencies": {
    "semver": "^7.8.5",
    "typescript": "^6.0.3"
  },
  "scripts": {
    "build": "rslib",
    "types:sync": "node dist/build/types-cli.js",
    "benchmark:routes": "node scripts/benchmark-routes.mjs",
    "build:shell": "pnpm --filter ./example/shell* run build",
    "build:host": "pnpm --filter ./example/host* run build",
    "build:subhost": "pnpm --filter ./example/sub-host* run build",
    "dev": "rslib --watch",
    "test": "node --experimental-transform-types --test \"src/**/*.test.ts\"",
    "test:watch": "node --experimental-transform-types --test --watch \"src/**/*.test.ts\"",
    "start:subhost": "pnpm build:subhost && pnpm --filter ./example/sub-host* --parallel --stream run server",
    "start:host": "pnpm --filter shell exec wait-on --timeout 120000 --log http-get://localhost:4001/mf/manifest.json && pnpm build:host && pnpm --filter ./example/host* --parallel --stream run server",
    "start:shell": "pnpm --filter shell exec wait-on --timeout 120000 --log http-get://localhost:4001/mf/manifest.json http-get://localhost:3001/mf/manifest.json http-get://localhost:3002/mf/manifest.json && pnpm build:shell && pnpm --filter ./example/shell* --parallel --stream run server",
    "start": "pnpm build && concurrently --kill-others --names subhost,host,shell \"pnpm start:subhost\" \"pnpm start:host\" \"pnpm start:shell\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@rsbuild/core": "^2.2.1",
    "@rslib/core": "^0.23.2",
    "@types/node": "^24.13.2",
    "@types/semver": "^7.8.0",
    "concurrently": "^10.0.6",
    "eslint": "^10.13.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
